    <Table>
      <Row><Cell ss:StyleID="sHdr"><Data ss:Type="String">ID</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">First_15_Sprint</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Status</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Layer</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Dimension</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Cost_Tag</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Build_Contract</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Control_Falsifier</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Pass_Target</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Prereqs</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M001</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">⏱ Oper</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">SoA TypedArray Memory Arena</Data></Cell><Cell><Data ss:Type="String">Pre-allocate contiguous SoA TypedArray buffers for units, synapses, soft vertices &amp; pools; fixed WASM pages.</Data></Cell><Cell><Data ss:Type="String">Run 10,000 post-warmup ticks under heap/WASM profiler.</Data></Cell><Cell><Data ss:Type="String">0 B alloc / 10k ticks</Data></Cell><Cell><Data ss:Type="String">ROOT</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M002</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">⚙ Comp</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Domain-Isolated Philox4x32 PRNG</Data></Cell><Cell><Data ss:Type="String">32-bit `Math.imul` `Philox4x32-10` keyed by `(ver,seed,domain,entity,organ,tick,purpose,idx)` isolating `WORLD_EXOG`.</Data></Cell><Cell><Data ss:Type="String">Delete 1 unit inside Organ A -&gt; check Organ B &amp; `WORLD_EXOG` draws.</Data></Cell><Cell><Data ss:Type="String">0 bit diff / 10k ticks</Data></Cell><Cell><Data ss:Type="String">M001</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M003</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">🏁 Stag</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Seed Firewall, Repo &amp; Manifest</Data></Cell><Cell><Data ss:Type="String">Verify standalone `.git` object store; partition Practice (`100–999`), Tuning (`2000–2999`), Burn-on-Fail Test (`≥5000`).</Data></Cell><Cell><Data ss:Type="String">Inject literal test seed `5001` into creature module -&gt; AST gate.</Data></Cell><Cell><Data ss:Type="String">0 leaks; 100% SHA</Data></Cell><Cell><Data ss:Type="String">M001,M002</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M004</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">🔄 Syst</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">11-Pool FP64 Kahan-Neumaier Ledger</Data></Cell><Cell><Data ss:Type="String">Closed 11 enthalpy/mass pools (`E_patch..E_heat_phys + E_diss_num ≥ 0`) in compensated `FP64` + Second-Law sink.</Data></Cell><Cell><Data ss:Type="String">Inject gross `-1e-5` AND subtle `-2e-11` leak mutants.</Data></Cell><Cell><Data ss:Type="String">|ΔE|/(E0+Ein) &lt; 1e-12</Data></Cell><Cell><Data ss:Type="String">M001</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M005</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">⏱ Oper</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">5-Gear Deterministic Multirate Clock</Data></Cell><Cell><Data ss:Type="String">Integer-divided gears (`0.5ms, 5ms, 50ms, 1s, 60s`) with explicit ZOH state hold and conservative flux accumulators.</Data></Cell><Cell><Data ss:Type="String">Benchmark vs all-`0.5ms` single-rate + `2×` step-halving check.</Data></Cell><Cell><Data ss:Type="String">≥5.0× speed; err &lt; 1%</Data></Cell><Cell><Data ss:Type="String">M001,M004</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M006</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">⏱ Oper</Data></Cell><Cell><Data ss:Type="String">[O(N_u)]</Data></Cell><Cell><Data ss:Type="String">Canonical `.alifebin` &amp; XOR Diff</Data></Cell><Cell><Data ss:Type="String">Little-endian `.alifebin` snapshot serializer + `&lt;64 KB` sparse XOR incremental checkpoint + core `exp_det`/`log_det`.</Data></Cell><Cell><Data ss:Type="String">Save at `t=5,000`, reload on fresh worker -&gt; compare `t=10,000` SHA-256.</Data></Cell><Cell><Data ss:Type="String">0 bit diff; Δ &lt; 64 KB</Data></Cell><Cell><Data ss:Type="String">M002,M005</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M007</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">⚙ Comp</Data></Cell><Cell><Data ss:Type="String">[Q≤10]</Data></Cell><Cell><Data ss:Type="String">Integer-Guarded Q≤10 Register</Data></Cell><Cell><Data ss:Type="String">Optional coherent register validating integer `0 ≤ Q ≤ 10` before allocating `2*(2**Q)` `Float64` (`≤16 KiB`) + classical control.</Data></Cell><Cell><Data ss:Type="String">Pass `Q=32`, `Q=-1`, `Q=3.5` -&gt; guard rejects without `1&lt;&lt;32` wrap.</Data></Cell><Cell><Data ss:Type="String">0 ≤ Q ≤ 10; ≤16 KiB</Data></Cell><Cell><Data ss:Type="String">M001,M002</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M008</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">📐 Desn</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Universal Typed Organ Adapter</Data></Cell><Cell><Data ss:Type="String">Implement `parts(), couplings(), readState(), writeState(), stimulate(), lesion(), shamLesion(), metrics()` with SI tags.</Data></Cell><Cell><Data ss:Type="String">Inject `mM` into `kJ` port or `NaN` state -&gt; runtime contract check.</Data></Cell><Cell><Data ss:Type="String">0 untyped/NaN ports</Data></Cell><Cell><Data ss:Type="String">M001,M004</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M009</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">🔄 Syst</Data></Cell><Cell><Data ss:Type="String">[O(P)]</Data></Cell><Cell><Data ss:Type="String">No-Cosmetic-Parts (`C-NC`) Sweep</Data></Cell><Cell><Data ss:Type="String">Automated perturbation harness verifies every declared organ, modulator &amp; soft parameter shifts active-regime trajectory.</Data></Cell><Cell><Data ss:Type="String">Attach disconnected display-only state array -&gt; `C-NC` audit.</Data></Cell><Cell><Data ss:Type="String">100% parts |Δy| &gt; ε</Data></Cell><Cell><Data ss:Type="String">M006,M008</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M010</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L0 Arena</Data></Cell><Cell><Data ss:Type="String">🏁 Stag</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Originality &amp; 5-Mutant CI Gate</Data></Cell><Cell><Data ss:Type="String">Static AST/import scanner bans world-oracle reads and verifies 0 copied external assets; runs 5 negative mutants.</Data></Cell><Cell><Data ss:Type="String">Run `Leaky-2e-11, Cosmetic, Oracle, Frozen, Shuffled` mutants.</Data></Cell><Cell><Data ss:Type="String">5 / 5 mutants rejected</Data></Cell><Cell><Data ss:Type="String">M003,M004,M009</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M011</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🔄 Syst</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Gánti Chemoton Polymer Triad</Data></Cell><Cell><Data ss:Type="String">Stoichiometrically couple autocatalytic cycle `A`, membrane lipid `T`, and template polymer `pV_n` (`n ≥ N*` division).</Data></Cell><Cell><Data ss:Type="String">Sever any 1 of the 3 cycles -&gt; measure survival/division persistence.</Data></Cell><Cell><Data ss:Type="String">3/3 cycles essential; δ≥0.8</Data></Cell><Cell><Data ss:Type="String">M004,M008</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M012</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🌊 Proc</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Michaelis-Menten Saturating Gut</Data></Cell><Cell><Data ss:Type="String">Enzymatic digestion &amp; uptake obey `v = V_max·[S]/(K_m+[S])` with implicit stiff step &amp; `[ATP]` allosteric brake.</Data></Cell><Cell><Data ss:Type="String">Bolus `100× K_m` nutrient shock vs linear-flux mutant.</Data></Cell><Cell><Data ss:Type="String">v ≤ V_max; 0 blowups</Data></Cell><Cell><Data ss:Type="String">M004,M011</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M013</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🌊 Proc</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">3-Phase Fasting &amp; Ketone Sparing</Data></Cell><Cell><Data ss:Type="String">Insulin glycogenesis/lipogenesis; fasting mobilizes FFA + protein-sparing `β-HB` ketones prior to Phase-III proteolysis.</Data></Cell><Cell><Data ss:Type="String">Fast replete organism vs ketogenesis-lesioned clone.</Data></Cell><Cell><Data ss:Type="String">≥1.6× protein-spared t</Data></Cell><Cell><Data ss:Type="String">M012</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M014</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🔄 Syst</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Positive-Orthant Antithetic Clamp</Data></Cell><Cell><Data ss:Type="String">Non-negative `z_1, z_2 ≥ 0` dual-rail antithetic integral controller (`γ=0` undiluted regime) + seasonal rheostasis.</Data></Cell><Cell><Data ss:Type="String">Apply `+25%` basal glucose step load vs P-only controller.</Data></Cell><Cell><Data ss:Type="String">|e_ss| &lt; 1% set-point</Data></Cell><Cell><Data ss:Type="String">M012</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M015</Data></Cell><Cell><Data ss:Type="String">YES (Stage 0-2 MVP)</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🎯 Func</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">3-Timescale Satiation &amp; TTC Drive</Data></Cell><Cell><Data ss:Type="String">Stretch + CCK + leptin meal termination; glucose `TTC` slope initiates foraging ahead of hypoglycemic threshold.</Data></Cell><Cell><Data ss:Type="String">Compare intact vs TTC-lesioned &amp; satiation-lesioned clones.</Data></Cell><Cell><Data ss:Type="String">Hypoglycemia t &lt; 2%</Data></Cell><Cell><Data ss:Type="String">M013,M014</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M016</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🌊 Proc</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Osmotic Pump &amp; Cori Lactate Loop</Data></Cell><Cell><Data ss:Type="String">Active ion pump counters Donnan swelling; anaerobic burst builds `[H+/lactate]` cleared post-sprint via Cori cycle.</Data></Cell><Cell><Data ss:Type="String">Block pump ATP (`lysis`) &amp; run sprint-recovery assay.</Data></Cell><Cell><Data ss:Type="String">|ΔOsm| &lt; 3%; pH ≥ 7.1</Data></Cell><Cell><Data ss:Type="String">M011,M012</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M017</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🎯 Func</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Garcia Delayed Taste Aversion</Data></Cell><Cell><Data ss:Type="String">Slow visceral emesis/toxin trace pairs ingested flavor cue across `≥ 300 s` delay in 1 trial.</Data></Cell><Cell><Data ss:Type="String">Present novel toxic flavor -&gt; re-offer 1,000 s later vs sham.</Data></Cell><Cell><Data ss:Type="String">Re-ingest ≤ 15%; δ≥0.6</Data></Cell><Cell><Data ss:Type="String">M012,M015</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M018</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🎯 Func</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Post-Absorptive Enthalpy Audit</Data></Cell><Cell><Data ss:Type="String">Cross-checks absorbed `E_gut -&gt; E_blood` kJ yield against oral sweet cue to extinguish `0-kJ` decoy lures.</Data></Cell><Cell><Data ss:Type="String">Offer sweet `0-kJ` lure alongside bland caloric patch.</Data></Cell><Cell><Data ss:Type="String">Decoy share ≤ 10% ≤3 bouts</Data></Cell><Cell><Data ss:Type="String">M015,M017</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M019</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🔄 Syst</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Ring-0 Cardiac &amp; O2 Perfusion</Data></Cell><Cell><Data ss:Type="String">Intrinsic Ring-0 cardiac + ventilatory CPGs scale organ O2/glucose delivery with exertion and ambient hypoxia.</Data></Cell><Cell><Data ss:Type="String">Drop dome `pO2` by `40%` -&gt; measure ventilation &amp; perfusion.</Data></Cell><Cell><Data ss:Type="String">Vent lift ≥ 1.8×; 0 NaN</Data></Cell><Cell><Data ss:Type="String">M012,M016</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M020</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L1 WetBio</Data></Cell><Cell><Data ss:Type="String">🌊 Proc</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">CYP Detox, ROS &amp; Immune Memory</Data></Cell><Cell><Data ss:Type="String">ATP-debited toxin clearance, ROS antioxidant defense, sickness lethargy, and adaptive secondary pathogen clearance.</Data></Cell><Cell><Data ss:Type="String">Primary vs secondary homologous pathogen challenge vs naive.</Data></Cell><Cell><Data ss:Type="String">2nd clear time ≤ 0.5× 1st</Data></Cell><Cell><Data ss:Type="String">M012,M019</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M021</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L2 Soft</Data></Cell><Cell><Data ss:Type="String">📐 Desn</Data></Cell><Cell><Data ss:Type="String">[O(V_m)]</Data></Cell><Cell><Data ss:Type="String">Incompressible Hydrostatic Coelom</Data></Cell><Cell><Data ss:Type="String">100% original parametric soft body conserving chamber volume (`C_vol`) so radial contraction drives axial extension.</Data></Cell><Cell><Data ss:Type="String">Radial squeeze test + cavity puncture negative control.</Data></Cell><Cell><Data ss:Type="String">|ΔV|/V_0 &lt; 1.0%</Data></Cell><Cell><Data ss:Type="String">M004,M008</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M022</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L2 Soft</Data></Cell><Cell><Data ss:Type="String">⚙ Comp</Data></Cell><Cell><Data ss:Type="String">[O(V_m)]</Data></Cell><Cell><Data ss:Type="String">XPBD Viscoelastic Membrane &amp; Damping</Data></Cell><Cell><Data ss:Type="String">Compliance-scaled XPBD (`α̃ = α/dt²`) storing reversible `E_elastic` and booking numerical damping to `E_diss_num ≥ 0`.</Data></Cell><Cell><Data ss:Type="String">10× nominal speed wall impact vs explicit-Euler baseline.</Data></Cell><Cell><Data ss:Type="String">0 NaN; ΔE_diss ≥ -1e-15</Data></Cell><Cell><Data ss:Type="String">M004,M021</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M023</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L2 Soft</Data></Cell><Cell><Data ss:Type="String">📐 Desn</Data></Cell><Cell><Data ss:Type="String">[O(V_m)]</Data></Cell><Cell><Data ss:Type="String">Biotensegrity &amp; Crevice Squeeze</Data></Cell><Cell><Data ss:Type="String">Pre-stressed cable-strut web + mutable catch-state (`≥10×` stiffness range) compressing cross-section through narrow gaps.</Data></Cell><Cell><Data ss:Type="String">0.55× diameter crevice traversal vs rigid-strut (`α→0`) clone.</Data></Cell><Cell><Data ss:Type="String">Pass ≥ 90% vs 0% rigid</Data></Cell><Cell><Data ss:Type="String">M021,M022</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M024</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L2 Soft</Data></Cell><Cell><Data ss:Type="String">⚙ Comp</Data></Cell><Cell><Data ss:Type="String">[O(V_m)]</Data></Cell><Cell><Data ss:Type="String">0-Brain Passive Terrain Stability</Data></Cell><Cell><Data ss:Type="String">Open-loop passive soft compliance absorbs uneven-terrain impacts and maintains forward CPG progression without central brain.</Data></Cell><Cell><Data ss:Type="String">Uneven obstacle ramp with 0-brain passive hydrostat vs rigid clone.</Data></Cell><Cell><Data ss:Type="String">≥1.8× dist; peak F ≤ 0.5×</Data></Cell><Cell><Data ss:Type="String">M022,M023</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M025</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L2 Soft</Data></Cell><Cell><Data ss:Type="String">🌊 Proc</Data></Cell><Cell><Data ss:Type="String">[O(V_m)]</Data></Cell><Cell><Data ss:Type="String">Dual-Medium Peristaltic &amp; Swim Gaits</Data></Cell><Cell><Data ss:Type="String">Phase-coupled open-loop motor primitives propel soft body via land peristalsis and Reynolds-consistent aquatic undulation.</Data></Cell><Cell><Data ss:Type="String">Land-to-water ramp transition vs single-gait frozen control.</Data></Cell><Cell><Data ss:Type="String">Speed ≥ 0.4 BL/s both media</Data></Cell><Cell><Data ss:Type="String">M022,M024</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M026</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L2 Soft</Data></Cell><Cell><Data ss:Type="String">🎯 Func</Data></Cell><Cell><Data ss:Type="String">[O(V_m)]</Data></Cell><Cell><Data ss:Type="String">Switchable Wet Adhesion &amp; Slime</Data></Cell><Cell><Data ss:Type="String">ATP-gated mucus adhesion/suction holds station in shear flow; secreted slime reduces follower drag (`-20%`).</Data></Cell><Cell><Data ss:Type="String">Fluid shear ramp vs adhesion-lesioned clone.</Data></Cell><Cell><Data ss:Type="String">Slip shear ≥ 3.0× control</Data></Cell><Cell><Data ss:Type="String">M012,M022</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M027</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L2 Soft</Data></Cell><Cell><Data ss:Type="String">🌊 Proc</Data></Cell><Cell><Data ss:Type="String">[O(V_m)]</Data></Cell><Cell><Data ss:Type="String">Puncture Leak, Clotting &amp; Blastema</Data></Cell><Cell><Data ss:Type="String">Membrane tear leaks coelomic pressure/stores until coagulation seals breach, followed by scar or amino-paid blastema.</Data></Cell><Cell><Data ss:Type="String">Standardized puncture vs clotting-lesioned negative control.</Data></Cell><Cell><Data ss:Type="String">Seal ≤ 15 s; loss &lt; 8% E0</Data></Cell><Cell><Data ss:Type="String">M011,M021</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">M028</Data></Cell><Cell><Data ss:Type="String">NO</Data></Cell><Cell><Data ss:Type="String">☐ Not Yet</Data></Cell><Cell><Data ss:Type="String">L2 Soft</Data></Cell><Cell><Data ss:Type="String">🎯 Func</Data></Cell><Cell><Data ss:Type="String">[O(1)]</Data></Cell><Cell><Data ss:Type="String">Local Nociceptive Reflex &amp; Autotomy</Data></Cell><Cell><Data ss:Type="String">Fast `Aδ` withdrawal + slow `C` unloading; severe mechanical trapping triggers booked fracture-plane lobe autotomy.</Data></Cell><Cell><Data ss:Type="String">Pin distal lobe under lethal hazard vs autotomy-disabled clone.</Data></Cell><Cell><Data ss:Type="String">Escape ≥ 85%; |ΔE| &lt; 1e-12</Data></Cell><Cell><Data ss:Type="String">M027</Data></Cell></Row>
