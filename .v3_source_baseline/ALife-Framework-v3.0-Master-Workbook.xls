    <Table>
      <Row><Cell ss:StyleID="sHdr"><Data ss:Type="String">Category</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">ID</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Name</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Col_A_Bits_Or_Cost</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Col_B_Role_Or_Target</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Col_C_Backend_Or_Safety</Data></Cell><Cell ss:StyleID="sHdr"><Data ss:Type="String">Specification</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM01</Data></Cell><Cell><Data ss:Type="String">Sub-1-bit VQ Codebook Weights</Data></Cell><Cell><Data ss:Type="String">&lt; 1 bit (32–64×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW Codec</Data></Cell><Cell><Data ss:Type="String">SW LUT (JS/WASM/WGSL)</Data></Cell><Cell><Data ss:Type="String">Codebook-shared crowd reflex weights; indices + LUT budgeted explicitly.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM02</Data></Cell><Cell><Data ss:Type="String">Binary Weights (+1 / -1)</Data></Cell><Cell><Data ss:Type="String">1 bit (32×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW Bitpack</Data></Cell><Cell><Data ss:Type="String">u32 XNOR+popcnt</Data></Cell><Cell><Data ss:Type="String">Ultra-fast bipolar VSA &amp; all-or-none axonal gating; FP32/int32 accumulator.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM03</Data></Cell><Cell><Data ss:Type="String">Ternary (BitNet b1.58: {-1,0,+1})</Data></Cell><Cell><Data ss:Type="String">1.60b (5 trits/B) (20× raw (15.6× CSR))</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW Bitpack</Data></Cell><Cell><Data ss:Type="String">5-trit/u8 codec</Data></Cell><Cell><Data ss:Type="String">Excitatory (+1), pruned (0), inhibitory (-1) packed weights; zero multiplies.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM04</Data></Cell><Cell><Data ss:Type="String">int2 / int3 Group-Scaled</Data></Cell><Cell><Data ss:Type="String">2–3 bits (10.7–16×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW Bitpack</Data></Cell><Cell><Data ss:Type="String">Bit-shift unpack</Data></Cell><Cell><Data ss:Type="String">Compact segmental soft-body CPG motor weights with FP16 block scale.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM05</Data></Cell><Cell><Data ss:Type="String">int4 Symmetric/Asymmetric Group</Data></Cell><Cell><Data ss:Type="String">4b (0.875 B blk) (8× raw (10.6× CSR))</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW Bitpack</Data></Cell><Cell><Data ss:Type="String">u32 nibble unpack</Data></Cell><Cell><Data ss:Type="String">Primary compact storage for peripheral ganglia &amp; sensory fan-out.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM06</Data></Cell><Cell><Data ss:Type="String">NF4 (4-bit NormalFloat LUT)</Data></Cell><Cell><Data ss:Type="String">4 bits + scale (8× raw)</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW LUT</Data></Cell><Cell><Data ss:Type="String">16-entry FP16/32 LUT</Data></Cell><Cell><Data ss:Type="String">Quantile-spaced 4-bit levels matched to bell-curved biological weights.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM07</Data></Cell><Cell><Data ss:Type="String">FP4 (OCP E2M1 Microfloat)</Data></Cell><Cell><Data ss:Type="String">4 bits (8× raw)</Data></Cell><Cell><Data ss:Type="String">Tier-2 GPU/SW</Data></Cell><Cell><Data ss:Type="String">Blackwell native / SW</Data></Cell><Cell><Data ss:Type="String">High-density Tier-2 crowd forward passes; requires group scale.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM08</Data></Cell><Cell><Data ss:Type="String">MXFP4 (32-elem + E8M0 shared exp)</Data></Cell><Cell><Data ss:Type="String">4.25 bits (7.5×)</Data></Cell><Cell><Data ss:Type="String">Tier-2 GPU/SW</Data></Cell><Cell><Data ss:Type="String">OCP GPU / SW unpack</Data></Cell><Cell><Data ss:Type="String">Shared 8-bit exponent acts like local cortical column gain.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM09</Data></Cell><Cell><Data ss:Type="String">int6 / FP6 (E3M2 / E2M3)</Data></Cell><Cell><Data ss:Type="String">6 bits (5.3×)</Data></Cell><Cell><Data ss:Type="String">Tier-2 SW/GPU</Data></Cell><Cell><Data ss:Type="String">Bitpack codec</Data></Cell><Cell><Data ss:Type="String">Intermediate precision for recurrent reservoirs sensitive to 4-bit quantization.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM10</Data></Cell><Cell><Data ss:Type="String">int8 / Q0.7 Symmetric Integer</Data></Cell><Cell><Data ss:Type="String">8 bits (1 B) (4.0×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 Native</Data></Cell><Cell><Data ss:Type="String">Int8Array / i32 dot</Data></Cell><Cell><Data ss:Type="String">Cross-platform bit-exact specialist weights; accumulates into int32/FP32.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM11</Data></Cell><Cell><Data ss:Type="String">FP8 E4M3 (4 exp, 3 mantissa)</Data></Cell><Cell><Data ss:Type="String">8 bits (1 B) (4.0×)</Data></Cell><Cell><Data ss:Type="String">Tier-2 GPU/SW</Data></Cell><Cell><Data ss:Type="String">Hopper+ CUDA / SW</Data></Cell><Cell><Data ss:Type="String">Forward activations in Tier-2 GPU cortices; SW codec on WebGPU.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM12</Data></Cell><Cell><Data ss:Type="String">FP8 E5M2 (5 exp, 2 mantissa)</Data></Cell><Cell><Data ss:Type="String">8 bits (1 B) (4.0×)</Data></Cell><Cell><Data ss:Type="String">Tier-2 GPU/SW</Data></Cell><Cell><Data ss:Type="String">Hopper+ CUDA / SW</Data></Cell><Cell><Data ss:Type="String">Wider exponent range for prediction-error &amp; eligibility transients.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM13</Data></Cell><Cell><Data ss:Type="String">MXFP8 (32-elem + E8M0 shared exp)</Data></Cell><Cell><Data ss:Type="String">8.25 bits (3.9×)</Data></Cell><Cell><Data ss:Type="String">Tier-2 GPU/SW</Data></Cell><Cell><Data ss:Type="String">OCP GPU / SW</Data></Cell><Cell><Data ss:Type="String">Block-scaled 8-bit online plasticity in workstation dGPU runs.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM14</Data></Cell><Cell><Data ss:Type="String">FP16 (IEEE-754 binary16)</Data></Cell><Cell><Data ss:Type="String">16 bits (2 B) (2.0×)</Data></Cell><Cell><Data ss:Type="String">Tier-2 Opt. GPU</Data></Cell><Cell><Data ss:Type="String">Float16Array / WGSL f16*</Data></Cell><Cell><Data ss:Type="String">Soft-tissue fields &amp; CSR weights (*WGSL `shader-f16` capability probe required).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM15</Data></Cell><Cell><Data ss:Type="String">BF16 (bfloat16: 8 exp, 7 mant)</Data></Cell><Cell><Data ss:Type="String">16 bits (2 B) (2.0×)</Data></Cell><Cell><Data ss:Type="String">Tier-2 GPU/SW</Data></Cell><Cell><Data ss:Type="String">CUDA/CPU native; WGSL SW</Data></Cell><Cell><Data ss:Type="String">FP32-like exponent range for workspace states; finite/NaN guards still required.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM16</Data></Cell><Cell><Data ss:Type="String">TF32 (19-bit TensorCore math mode)</Data></Cell><Cell><Data ss:Type="String">32b store (19b math) (1.0× (No RAM save!))</Data></Cell><Cell><Data ss:Type="String">Tier-2 CUDA Only</Data></Cell><Cell><Data ss:Type="String">NVIDIA TensorCore</Data></Cell><Cell><Data ss:Type="String">Accelerates FP32 matmuls on Ampere+ GPUs; occupies full 32-bit storage (`ALF-006`).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM17</Data></Cell><Cell><Data ss:Type="String">FP32 / Q16.16 Fixed-Point State</Data></Cell><Cell><Data ss:Type="String">32 bits (4 B) (1.0× (Reference))</Data></Cell><Cell><Data ss:Type="String">Tier-1 Canonical</Data></Cell><Cell><Data ss:Type="String">Float32/Int32 Native</Data></Cell><Cell><Data ss:Type="String">Canonical kinematics/membrane state (`Q16.16` for integer lockstep; never for kJ ledger).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM18</Data></Cell><Cell><Data ss:Type="String">FP64 + Kahan-Neumaier Compensation</Data></Cell><Cell><Data ss:Type="String">64 bits (8 B) (0.5×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 Mandatory</Data></Cell><Cell><Data ss:Type="String">Float64Array / WASM f64</Data></Cell><Cell><Data ss:Type="String">MANDATORY for all 11 First-Law enthalpy/mass pools (`|ΔE|/(E0+Ein) &lt; 1e-12`; WGSL lacks f64).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM19</Data></Cell><Cell><Data ss:Type="String">Posit8 / Posit16 Tapered Float</Data></Cell><Cell><Data ss:Type="String">8–16 bits (2–4×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW Codec</Data></Cell><Cell><Data ss:Type="String">Software LUT/ALU</Data></Cell><Cell><Data ss:Type="String">Concentrates significand bits near unity around homeostatic set-points.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM20</Data></Cell><Cell><Data ss:Type="String">Logarithmic Number System (LNS)</Data></Cell><Cell><Data ss:Type="String">8–16 bits (2–4×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW Codec</Data></Cell><Cell><Data ss:Type="String">Software LUT/Add</Data></Cell><Cell><Data ss:Type="String">Matches Weber-Fechner sensory compression; turns products into fixed-point adds.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM21</Data></Cell><Cell><Data ss:Type="String">[Modifier] Keyed Stochastic Rounding</Data></Cell><Cell><Data ss:Type="String">+Philox draw (Modifier (0× own))</Data></Cell><Cell><Data ss:Type="String">Tier-1 Keyed-Det</Data></Cell><Cell><Data ss:Type="String">SW quantizer op</Data></Cell><Cell><Data ss:Type="String">Quantization operator (not a storage type) preventing small Δw stagnation in 4–8b formats.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM22</Data></Cell><Cell><Data ss:Type="String">Block Floating Point (BFP-8/4)</Data></Cell><Cell><Data ss:Type="String">4–8b + 8b exp (3.8–7.5×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 SW/SIMD</Data></Cell><Cell><Data ss:Type="String">Int SIMD + shift</Data></Cell><Cell><Data ss:Type="String">Integer SIMD dot products across shared-exponent cortical minicolumns.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM23</Data></Cell><Cell><Data ss:Type="String">[Model] Noisy Analog / Drift Channel</Data></Cell><Cell><Data ss:Type="String">FP16/32 + noise (1–2×)</Data></Cell><Cell><Data ss:Type="String">Tier-1 Keyed-Det</Data></Cell><Cell><Data ss:Type="String">Keyed Langevin step</Data></Cell><Cell><Data ss:Type="String">Simulates wet ion-channel shot noise &amp; conductance drift under keyed PRNG.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM24</Data></Cell><Cell><Data ss:Type="String">[Coding] Sparse AER Spike Events</Data></Cell><Cell><Data ss:Type="String">32b (id+tick) (Event-proportional)</Data></Cell><Cell><Data ss:Type="String">Tier-1 Canonical</Data></Cell><Cell><Data ss:Type="String">Uint32 ring queue</Data></Cell><Cell><Data ss:Type="String">Zero synaptic propagation work while silent (basal membrane leak/pump ATP still ticks).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">PRECISION_25</Data></Cell><Cell><Data ss:Type="String">PM25</Data></Cell><Cell><Data ss:Type="String">[Policy] Heterogeneous Multi-Precision</Data></Cell><Cell><Data ss:Type="String">1.6b–64b (6–14× (Workload))</Data></Cell><Cell><Data ss:Type="String">Tier-1/2 Hybrid</Data></Cell><Cell><Data ss:Type="String">Typed S2S bridges</Data></Cell><Cell><Data ss:Type="String">Per-organ assignment: b1.58/int4 limbs + int8 cortex + FP32 mind + FP64 ledger.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF01</Data></Cell><Cell><Data ss:Type="String">Spiking Neural Networks (LIF / Izhikevich / AdEx)</Data></Cell><Cell><Data ss:Type="String">O(N_units + k·E_syn)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Event-driven sparse spikes (`k ≈ 1–4%`), refractory timing, STDP, and per-spike ATP debit.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF02</Data></Cell><Cell><Data ss:Type="String">Liquid Time-Constant (LTC) ODE Networks</Data></Cell><Cell><Data ss:Type="String">O(K_iter·E_syn)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">State- and input-modulated conductance `τ(x,I)` integrated via `K_iter` bounded substeps.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF03</Data></Cell><Cell><Data ss:Type="String">Closed-Form Continuous-Time (CfC) Networks</Data></Cell><Cell><Data ss:Type="String">O(E_syn)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Bounded analytical approximation to LTC trajectories—eliminates stiff neural ODE sub-stepping.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF04</Data></Cell><Cell><Data ss:Type="String">Spiking Liquid Time-Constant (sLTC, Vanhalle &amp; Gielen 2025)</Data></Cell><Cell><Data ss:Type="String">O(N_units + k·E_syn)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Adaptive liquid time constants + sparse spikes (up to 9.2× lower energy vs LTC on benchmark tasks).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF05</Data></Cell><Cell><Data ss:Type="String">Liquid State / Echo-State Reservoirs (LSM / FORCE)</Data></Cell><Cell><Data ss:Type="String">O(E_syn + D_lat²)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Fixed spectral-clamped sparse recurrent pool (`‖W‖_2 ≤ 0.99`) with fast plastic linear/FORCE readout.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF06</Data></Cell><Cell><Data ss:Type="String">Structured State-Space Models (S4 / Diagonal Linear RNN)</Data></Cell><Cell><Data ss:Type="String">O(N_units)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Long-horizon temporal memory across thousands of ticks with `O(1)` recurrent state update per unit.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF07</Data></Cell><Cell><Data ss:Type="String">Selective State-Space (Mamba-style Input-Gated SSM)</Data></Cell><Cell><Data ss:Type="String">O(N_units·D_lat)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Content-selective input gates decide which sensory surprises write into persistent recurrent state.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF08</Data></Cell><Cell><Data ss:Type="String">Latent Predictive World Models (RSSM / JEPA)</Data></Cell><Cell><Data ss:Type="String">O(D_lat²)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Forecasts compact visceral + exteroceptive embeddings (never raw pixels) for rollout planning.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF09</Data></Cell><Cell><Data ss:Type="String">Modern Continuous Hopfield Associative Memory</Data></Cell><Cell><Data ss:Type="String">O(M_pat·D_lat)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Exponential pattern capacity retrieving full episodes from `≥ 50%` occluded cues in 1–3 settling steps.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF10</Data></Cell><Cell><Data ss:Type="String">Kolmogorov-Arnold Spline/LUT Networks (KAN)</Data></Cell><Cell><Data ss:Type="String">O(E_syn·G_sp)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Piecewise-polynomial/LUT univariate edge functions for compact, interpretable visceral control laws.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF11</Data></Cell><Cell><Data ss:Type="String">Continuous Neural ODEs / Langevin Neural SDEs</Data></Cell><Cell><Data ss:Type="String">O(K_iter·E_syn)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Continuous vector fields coupling physiology and neural state (requires multi-bit precision ≥ FP16).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF12</Data></Cell><Cell><Data ss:Type="String">Developmental Hypernetworks / Coordinate CPPNs</Data></Cell><Cell><Data ss:Type="String">O(G_gen·E_macro)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Compact genome queries 3D tissue coordinates `(x,y,z,d)` at developmental milestones (Gear 4).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF13</Data></Cell><Cell><Data ss:Type="String">Sparse Top-k Mixture-of-Experts (MoE Specialist Router)</Data></Cell><Cell><Data ss:Type="String">O(k_exp·E_expert)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Activates only `k_exp = 1..2` specialist spheres per step, decoupling capacity from per-tick FLOPs.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF14</Data></Cell><Cell><Data ss:Type="String">Neural Cellular Automata (NCA) &amp; Chemoton Tissue Grids</Data></Cell><Cell><Data ss:Type="String">O(Cells)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Local neighbor signaling grows, polarizes, and regenerates multicellular soft soma after injury.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF15</Data></Cell><Cell><Data ss:Type="String">Hierarchical Predictive Coding / Active Inference</Data></Cell><Cell><Data ss:Type="String">O(L_lay·D_lat²)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Top-down predictions cancel expected sensory input; precision-weighted residuals drive belief &amp; action.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF16</Data></Cell><Cell><Data ss:Type="String">Multi-Compartment Apical-Basal Dendritic Units (dCaAP)</Data></Cell><Cell><Data ss:Type="String">O(B_comp·N_units)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Segregated basal drive + apical context calcium plateaus solving single-cell XOR (Gidon et al. 2020).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF17</Data></Cell><Cell><Data ss:Type="String">Three-Factor Eligibility + BTSP Plateau Plasticity</Data></Cell><Cell><Data ss:Type="String">O(k·E_syn)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Decaying `pre × post` tags converted to weight updates on delayed phasic neuromodulator/plateau arrival.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF18</Data></Cell><Cell><Data ss:Type="String">Constant-Memory Gated Recurrence (xLSTM / RWKV-lite)</Data></Cell><Cell><Data ss:Type="String">O(D_lat²)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Matrix-valued recurrent memory cells maintaining constant `O(1)` step cost over unbounded lifetimes.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF19</Data></Cell><Cell><Data ss:Type="String">Part-Whole Pose Capsule / Frame Networks</Data></Cell><Cell><Data ss:Type="String">O(C_caps²·D_pose)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Tracks object-to-body and segment-to-segment coordinate frames across viewpoint/posture shifts.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF20</Data></Cell><Cell><Data ss:Type="String">Message-Passing Graph Neural Networks (Morphology GNN)</Data></Cell><Cell><Data ss:Type="String">O(E_body)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Propagates tension, perfusion, and proprioception natively over variable-limb soft body graphs.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF21</Data></Cell><Cell><Data ss:Type="String">Energy-Based Settling Networks (Ising / Equilibrium)</Data></Cell><Cell><Data ss:Type="String">O(K_iter·E_syn)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Relaxes fast threat/posture constraints on a bounded Lyapunov energy surface (`K_iter ≤ 8`).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF22</Data></Cell><Cell><Data ss:Type="String">2-Step Consistency / Flow-Matching Motor Policies</Data></Cell><Cell><Data ss:Type="String">O(2·D_pol²)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Generates smooth multimodal soft-continuum obstacle-avoidance trajectories in 2 fixed denoiser steps.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF23</Data></Cell><Cell><Data ss:Type="String">Hyperdimensional / Vector-Symbolic Algebras (VSA / MAP)</Data></Cell><Cell><Data ss:Type="String">O(D_lat)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">SIMD bitwise/XOR/permutation role-filler binding over `1,024–4,096d` bipolar/ternary vectors.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF24</Data></Cell><Cell><Data ss:Type="String">Event-Driven Address-Event Neuromorphic Cores (AER)</Data></Cell><Cell><Data ss:Type="String">O(k·E_syn)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Asynchronous event queues touching outgoing edges strictly on threshold crossings.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">MODEL_25</Data></Cell><Cell><Data ss:Type="String">MF25</Data></Cell><Cell><Data ss:Type="String">Multi-Scale Frankenstein Organ Hybrids</Data></Cell><Cell><Data ss:Type="String">Sum(Sub-organs)</Data></Cell><Cell><Data ss:Type="String">Neural/Dynamical</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Principled composition: NCA/XPBD soma + int4 CfC ganglia + sLTC/Hopfield/Workspace central brain.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW01</Data></Cell><Cell><Data ss:Type="String">Typed Metric Vector Spaces</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Explicit unit-tagged coordinate spaces linking transducers, latents, and motor targets.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW02</Data></Cell><Cell><Data ss:Type="String">Bilateral / Radial Group-Symmetric Wiring</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Mirrors paired left-right or radial soft-segment circuits from one compact genomic specification.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW03</Data></Cell><Cell><Data ss:Type="String">Clifford (Geometric) Algebra Rotors</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Encodes 2D/3D orientations, bivector torques, and soft-segment bends without gimbal singularities.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW04</Data></Cell><Cell><Data ss:Type="String">Hyperbolic (Poincaré / Lorentz) Manifolds</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Embeds exponential phylogenetic, taxonomic, and subgoal trees cleanly (requires FP16/FP32 adapter).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW05</Data></Cell><Cell><Data ss:Type="String">Spherical &amp; Toroidal Phase Manifolds</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Wrap-around topology for compass headings, circadian phases, and multi-limb gait oscillators.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW06</Data></Cell><Cell><Data ss:Type="String">Contractive Induced-Norm Manifolds (`‖W‖_2 ≤ 0.99`)</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Bounds singular values (`‖W‖_2 ≤ 0.99`, implying `ρ(W) ≤ 0.99`) to prevent transient &amp; asymptotic blowup.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW07</Data></Cell><Cell><Data ss:Type="String">3D Distance-Delay Tissue Wiring</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Axonal connection probability, metabolic wire rent, and integer spike delay scale with 3D tissue distance.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW08</Data></Cell><Cell><Data ss:Type="String">Watts-Strogatz Small-World Connectomes</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">High local clustering plus sparse long-range shortcuts yielding `O(log N)` broadcast at low cable volume.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW09</Data></Cell><Cell><Data ss:Type="String">Scale-Free Rich-Club Hub Networks</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Heavy-tailed hub architecture supporting targeted hub-vs-periphery lesion resilience assays.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW10</Data></Cell><Cell><Data ss:Type="String">Hub-and-Sphere Modular Bottlenecks</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Dense specialist spheres communicating exclusively through capacity-limited workspace/thalamic hubs.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW11</Data></Cell><Cell><Data ss:Type="String">Recursive L-System Vascular &amp; Axonal Trees</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Self-similar branching rules growing perfusion vessels and peripheral nerve trunks from tiny genomes.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW12</Data></Cell><Cell><Data ss:Type="String">Persistent Homology (Betti-0/1/2 Signatures)</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Diagnostic topological audit of ring attractors, toroidal maps, and soft-cavity loops.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW13</Data></Cell><Cell><Data ss:Type="String">SE(2) / SE(3) Equivariant Steerable Kernels</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Guarantees rotational/translational equivariance for local tactile/odor/visual feature detectors (≥int8/FP16).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW14</Data></Cell><Cell><Data ss:Type="String">Cellular Sheaf Consensus Maps</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Linear edge restriction maps reconciling disagreements across heterogeneous sensory coordinate frames.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW15</Data></Cell><Cell><Data ss:Type="String">Sinkhorn Optimal-Transport Somatotopy</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Smoothly remaps variable-node larval/adult skin and retina sheets onto fixed cortical arrays.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW16</Data></Cell><Cell><Data ss:Type="String">Corecursive Stream Coalgebra Interfaces</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Formalizes open-ended organism-environment step transitions as typed `(State × Input) -&gt; (State × Output)`.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW17</Data></Cell><Cell><Data ss:Type="String">Decursive Self-Deduplication (DSD)</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Reserved Concept (Alex Donahue)</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Alex Donahue&apos;s reserved novel concept (preserved verbatim as author-defined slot per specification).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW18</Data></Cell><Cell><Data ss:Type="String">Juvenile Overproduction &amp; Sleep Pruning</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Synaptogenesis overshoot followed by size-scaled NREM activity-dependent pruning and waking re-sprout.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW19</Data></Cell><Cell><Data ss:Type="String">Amari Mexican-Hat Neural &amp; Morphogen Fields</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Local excitation + surround inhibition sheets driving spatial attention peaks and Turing skin patterns.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW20</Data></Cell><Cell><Data ss:Type="String">Holographic Reduced Representations (HRR)</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Circular-convolution binding (`O(D log D)` FFT or `O(D)` permutations) for compositional symbol structures.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW21</Data></Cell><Cell><Data ss:Type="String">Continuous Attractor Bump Sheets (Ring / Hex)</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Translation-invariant recurrent sheets integrating velocity into dead-reckoned heading and place bumps.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW22</Data></Cell><Cell><Data ss:Type="String">k-WTA Sparse Distributed Representations (2% SDR)</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Top-2% winner-take-all expansion (clean-slate design target inspired by 5–10% fly Kenyon sparsity).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW23</Data></Cell><Cell><Data ss:Type="String">Ramon-y-Cajal Wiring-Volume Minimization</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Co-evolves ganglion placement inside the soft body to minimize `Sum(weight_volume × distance)` ATP rent.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW24</Data></Cell><Cell><Data ss:Type="String">Simplicial / Hypergraph Triadic Couplings</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Captures 3-way neuron-astrocyte-modulator gates and multi-agent social coalitions natively.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">GEOMETRY_25</Data></Cell><Cell><Data ss:Type="String">GW25</Data></Cell><Cell><Data ss:Type="String">Nested Brains-Within-Brains + Typed S2S Bridges</Data></Cell><Cell><Data ss:Type="String">Topological</Data></Cell><Cell><Data ss:Type="String">Wiring Substrate</Data></Cell><Cell><Data ss:Type="String">All Tiers</Data></Cell><Cell><Data ss:Type="String">Multi-level hierarchy (`b1.58/int4` limbs -&gt; `int8` cortex -&gt; `BF16/FP32` mind) linked by `S2S` adapters.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP01</Data></Cell><Cell><Data ss:Type="String">SetWeight / ScaleBlock</Data></Cell><Cell><Data ss:Type="String">Tier-0 (&lt;0.1ms) + ATP debit</Data></Cell><Cell><Data ss:Type="String">CSR / Packed Block</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Scale/update Ring-1/2 weights; enforce contractive induced norm `‖W‖_2 ≤ 0.99` (power-iteration bound).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP02</Data></Cell><Cell><Data ss:Type="String">Prune / Grow</Data></Cell><Cell><Data ss:Type="String">Tier-1 shadow rollout</Data></Cell><Cell><Data ss:Type="String">Structural Mask</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Toggle `structuralMask` (separate from `lesionMask`); preserve sensor-to-motor reachability.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP03</Data></Cell><Cell><Data ss:Type="String">Rewire</Data></Cell><Cell><Data ss:Type="String">Tier-1 shadow rollout</Data></Cell><Cell><Data ss:Type="String">CSR + Overlay Graph</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Redirect edge within 3D cable budget; writes to explicit CSR delta overlay if base block is procedural.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP04</Data></Cell><Cell><Data ss:Type="String">PaintBiasField / ShiftBias</Data></Cell><Cell><Data ss:Type="String">Tier-0 rate + NaN guard</Data></Cell><Cell><Data ss:Type="String">Sheet Excitability</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Smooth spatial threshold/gain field over neural sheet keeping firing rate within `[0, r_max]`.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP05</Data></Cell><Cell><Data ss:Type="String">Move / ReEmbed</Data></Cell><Cell><Data ss:Type="String">Tier-1 shadow rollout</Data></Cell><Cell><Data ss:Type="String">3D / Manifold Coords</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Shift unit coordinates, recompute integer axonal delays &amp; Cajal wire rent; update CSR overlay.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP06</Data></Cell><Cell><Data ss:Type="String">Bind / Unbind / Reweight</Data></Cell><Cell><Data ss:Type="String">Tier-0 norm + cosine check</Data></Cell><Cell><Data ss:Type="String">VSA / Hopfield Memory</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Insert, unbind, or reweight associative role-filler vectors with norm renormalization.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP07</Data></Cell><Cell><Data ss:Type="String">Requantise</Data></Cell><Cell><Data ss:Type="String">Tier-1 drift ≤ ε_quant</Data></Cell><Cell><Data ss:Type="String">Module Precision</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Transition Ring-1/2 organ precision (e.g. `FP16 -&gt; int4` via keyed stochastic rounding + S2S update).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP08</Data></Cell><Cell><Data ss:Type="String">Constrain</Data></Cell><Cell><Data ss:Type="String">Tier-0 exact projection</Data></Cell><Cell><Data ss:Type="String">Manifold Projection</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Project matrix onto Dale&apos;s-law sign mask, zero-row-sum, or orthogonal/spectral ball `‖W‖_2 ≤ 0.99`.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP09</Data></Cell><Cell><Data ss:Type="String">Merge / Split / Graft</Data></Cell><Cell><Data ss:Type="String">Tier-2 full non-inferiority</Data></Cell><Cell><Data ss:Type="String">Specialist Spheres</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Fork/fuse Ring-1 modules or apply MHC-verified horizontal plasmid graft (when niche-enabled).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">WSE_OP_10</Data></Cell><Cell><Data ss:Type="String">WSE-OP10</Data></Cell><Cell><Data ss:Type="String">Freeze / Unfreeze</Data></Cell><Cell><Data ss:Type="String">Tier-0 hardware ACL</Data></Cell><Cell><Data ss:Type="String">Protection Ring ACL</Data></Cell><Cell><Data ss:Type="String">Ring-0 Guarded</Data></Cell><Cell><Data ss:Type="String">Consolidate plastic skill masks; `Ring-0` brainstem, nociception &amp; First-Law ledger permanently read-only.</Data></Cell></Row>
    </Table>
  </Worksheet>
