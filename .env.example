# Optional environment overrides for alife-singularity-omega-package (v3.4.0)
# Copy to .env (never commit .env!) if overriding default local paths or simulation budgets.

# Path to Chromium/Chrome executable for headless PDF rendering & Gate 17 DOM stress tests
ALIFE_CHROME_EXE="C:/Program Files/Google/Chrome/Application/chrome.exe"

# Path to Tectonic binary for AMS-LaTeX white-paper & clean-room arXiv tarball builds
ALIFE_TECTONIC_EXE="tectonic"

# Path to Lean 4.35.0 lake binary
ALIFE_LAKE_EXE="lake"

# Optional mirror target directory for Gate 18 dual-drive SHA-256 verification
ALIFE_MIRROR_ROOT=""

# Paired seed count for live empirical falsification (canonical default: 48 -> 748 total runs)
ALIFE_PAIRED_SEEDS=48
