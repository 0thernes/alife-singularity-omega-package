{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alifeops.omega/schemas/ovbs-52-v3.3-unified.json",
  "title": "Unified Omega Vitality (OVBS-52) & Clean-Slate v3.0 Verification Schema (v3.3-Omega)",
  "description": "Machine-readable schema evaluating Artificial Life, AG-Life, A-Life Singularity, Super A-Life, and Post-Singularity SUPER LIFE across 8 weighted OVBS-52 pillars, 52 metrics, 5 anti-gaming gates, and optional/extended Clean-Slate v3.0 11-Pool FP64 conservation, Holm-Bonferroni FWER statistics, and 5-mutant Anti-LARP verification.",
  "type": "object",
  "required": [
    "run_id",
    "timestamp_utc",
    "track",
    "substrate_id",
    "horizon_ticks",
    "pillar_scores",
    "anti_gaming_gates",
    "composite_ovi_score",
    "stage_classification"
  ],
  "properties": {
    "run_id": { "type": "string", "pattern": "^ALIFE-[A-Z0-9-]+$" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "track": { "type": "string", "enum": ["TRACK_A_CONSTITUTIONAL", "TRACK_B_FERAL_SIM", "HYBRID_ABLATION"] },
    "substrate_id": { "type": "string" },
    "horizon_ticks": { "type": "integer", "minimum": 1 },
    "composite_ovi_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "stage_classification": {
      "type": "string",
      "enum": [
        "STAGE_0_INERT",
        "STAGE_1_NARROW_ALIFE",
        "STAGE_2_AG_LIFE",
        "STAGE_3_ALIFE_SINGULARITY",
        "STAGE_4_SUPER_ALIFE",
        "STAGE_5_CONVERGED_SYNTHESIS",
        "STAGE_6_POST_BEYOND_SUPER_LIFE"
      ]
    },
    "pillar_weights": {
      "type": "object",
      "properties": {
        "P1_OEE_NOVELTY": { "const": 0.18 },
        "P2_AUTOPOIESIS_PERSISTENCE": { "const": 0.12 },
        "P3_HYPER_MORPHOGENESIS": { "const": 0.12 },
        "P4_RECURSIVE_META_EVOLVABILITY": { "const": 0.16 },
        "P5_ASSEMBLY_UNIVERSAL_CONSTRUCTION": { "const": 0.12 },
        "P6_THERMODYNAMIC_SUBSTRATE_MASTERY": { "const": 0.10 },
        "P7_MULTISCALE_AGENCY_INDIVIDUALITY": { "const": 0.12 },
        "P8_FERAL_RESILIENCE_CRITICALITY": { "const": 0.08 }
      }
    },
    "pillar_scores": {
      "type": "object",
      "required": [
        "P1_OEE_NOVELTY",
        "P2_AUTOPOIESIS_PERSISTENCE",
        "P3_HYPER_MORPHOGENESIS",
        "P4_RECURSIVE_META_EVOLVABILITY",
        "P5_ASSEMBLY_UNIVERSAL_CONSTRUCTION",
        "P6_THERMODYNAMIC_SUBSTRATE_MASTERY",
        "P7_MULTISCALE_AGENCY_INDIVIDUALITY",
        "P8_FERAL_RESILIENCE_CRITICALITY"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "anti_gaming_gates": {
      "type": "object",
      "required": [
        "white_noise_rejection_passed",
        "intron_bloat_knockout_passed",
        "spiegelman_penalty_factor",
        "t0_scaffold_subtracted",
        "dual_observer_verified",
        "gamma_multiplier"
      ],
      "properties": {
        "white_noise_rejection_passed": { "type": "boolean" },
        "intron_bloat_knockout_passed": { "type": "boolean" },
        "spiegelman_penalty_factor": { "type": "number", "minimum": 0, "maximum": 1 },
        "t0_scaffold_subtracted": { "type": "boolean" },
        "dual_observer_verified": { "type": "boolean" },
        "gamma_multiplier": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "v3_clean_slate_verification": {
      "type": "object",
      "required": [
        "seed_firewall_tier",
        "paired_seeds_n",
        "first_law_drift_fp64",
        "second_law_diss_num_min",
        "heat_backflow_faults",
        "wilcoxon_p_raw",
        "holm_fwer_p",
        "delta_pair_vs_feral",
        "lcb_95_ovi_diff",
        "anti_larp_mutants_rejected"
      ],
      "properties": {
        "seed_firewall_tier": { "type": "string" },
        "paired_seeds_n": { "type": "integer", "minimum": 1 },
        "first_law_drift_fp64": { "type": "number", "minimum": 0, "exclusiveMaximum": 1e-12 },
        "second_law_diss_num_min": { "type": "number", "minimum": -1e-15 },
        "heat_backflow_faults": { "type": "integer", "const": 0 },
        "wilcoxon_p_raw": { "type": "number", "minimum": 0, "maximum": 1 },
        "holm_fwer_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "delta_pair_vs_feral": { "type": "number", "minimum": -1, "maximum": 1 },
        "lcb_95_ovi_diff": { "type": "number" },
        "anti_larp_mutants_rejected": { "type": "integer", "minimum": 5, "maximum": 5 },
        "ring0_blocked_edits": { "type": "number", "minimum": 0 }
      }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 52,
      "items": {
        "type": "object",
        "required": ["benchmark_id", "pillar", "raw_value", "normalized_score", "status"],
        "properties": {
          "benchmark_id": { "type": "string", "pattern": "^BM-[A-Z]{3}-[0-9]{2}$" },
          "pillar": { "type": "string" },
          "raw_value": { "type": "number" },
          "normalized_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "SINGULARITY_TRIGGER"] }
        }
      }
    },
    "engine_receipts": { "type": "object" },
    "total_lean4_theorems": { "type": "integer", "minimum": 0 }
  }
}
